{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wichitaforever2",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-08",

  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Hono/CF"
  },

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wichitaforever",
      "database_id": "aa25b761-3415-4f8d-bf78-7d80746e17c7"
    }
  ],

  "upload_source_maps": true
}
